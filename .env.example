# Copiar a ../.env.local (fuera del repo, junto a secretos/) y llenar. En Vercel van como variables de entorno.
# AUTH_SECRET: generar con `npx auth secret`
AUTH_SECRET=
# Cliente OAuth de Google (paso 3 del plan)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# BigQuery, service account tableros-lectura@ (una de las dos):
#   local  → BQ_KEYFILE=../secretos/tableros-lectura.json
#   Vercel → BQ_CREDENCIALES=<contenido del JSON de la llave>
BQ_KEYFILE=
BQ_CREDENCIALES=
# Acceso por usuario (/admin, 2026-10-27). ADMINS: correos que siempre administran, separados por coma.
ADMINS=
# Vercel Global Config (antes Edge Config) donde vive la lista de acceso. GLOBAL_CONFIG la pone Vercel al conectar el store al
# proyecto; EDGE_CONFIG_ID + VERCEL_API_TOKEN (token con permiso de escritura) + VERCEL_TEAM_ID (equipo) para que /growth escriba.
# En local, sin GLOBAL_CONFIG, la lista vive en ACCESO_ARCHIVO (por omisión ../secretos/acceso.json).
GLOBAL_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
ACCESO_ARCHIVO=
